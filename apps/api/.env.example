PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/food_delivery
AUTH_URL=http://localhost:8787
WEB_URL=http://localhost:3000
# Web と API を別のサブドメインに配備する場合だけ、両方が属する管理下のドメインを指定する
# AUTH_COOKIE_DOMAIN=example.com
# 本番では暗号学的な乱数から生成した 32 文字以上の値に置き換える
AUTH_SECRET=development-only-secret-change-before-deploy
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_FROM=no-reply@example.test
# OpenCage Geocoding API のサーバー用キー（未設定時は住所の登録・変更が503）
# OPENCAGE_API_KEY=
GEOCODING_TIMEOUT_MS=5000

# F-06: optional Stripe test-mode key (unset => checkout returns 503).
# Live keys are rejected. Never commit a real key.
# STRIPE_SECRET_KEY=
